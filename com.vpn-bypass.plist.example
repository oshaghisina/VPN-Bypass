<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vpn-bypass</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__SCRIPT_FILE__</string>
    <string>--config</string>
    <string>__CONFIG_PATH__</string>
    <string>--history</string>
    <string>__HISTORY_PATH__</string>
    <string>--snapshot</string>
    <string>__SNAPSHOT_PATH__</string>
    <string>--timestamps</string>
    <string>apply</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>60</integer>

  <key>WatchPaths</key>
  <array>
    <string>__CONFIG_PATH__</string>
  </array>

  <key>StandardOutPath</key>
  <string>/var/log/vpn-bypass.log</string>

  <key>StandardErrorPath</key>
  <string>/var/log/vpn-bypass.log</string>
</dict>
</plist>
